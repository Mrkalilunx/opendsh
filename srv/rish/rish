#!/system/bin/sh
BASEDIR=$(dirname "$0")
DEX="$BASEDIR"/rish_shizuku.dex

if [ ! -f "$DEX" ]; then
  echo "Cannot find $DEX, please check the tutorial in Shizuku app"
  exit 1
fi

if [ $(getprop ro.build.version.sdk) -ge 34 ]; then
  if [ -w $DEX ]; then
    echo "On Android 14+, app_process cannot load writable dex."
    echo "Attempting to remove the write permission..."
    chmod 400 $DEX
  fi
  if [ -w $DEX ]; then
    echo "Cannot remove the write permission of $DEX."
    echo "You can copy to file to terminal app's private directory (/data/data/<package>, so that remove write permission is possible"
    exit 1
  fi
fi

# Replace "PKG" with the application id of your terminal app
# dsh 改动：不再写死 com.termux，改为从数据目录末段取包名
# so: 上游默认值是给官方 Termux 用的，改包名的分支版和别的终端 app 会认证失败
# so: 这里只做兜底推导，调用方传了 RISH_APPLICATION_ID 就以调用方为准
if [ -z "$RISH_APPLICATION_ID" ]; then
  RISH_APPLICATION_ID="${TERMUX_APP__LEGACY_DATA_DIR##*/}"
  [ -z "$RISH_APPLICATION_ID" ] && RISH_APPLICATION_ID="${TERMUX_APP__DATA_DIR##*/}"
  [ -z "$RISH_APPLICATION_ID" ] && RISH_APPLICATION_ID="com.termux"
  export RISH_APPLICATION_ID
fi
/system/bin/app_process -Djava.class.path="$DEX" /system/bin --nice-name=rish rikka.shizuku.shell.ShizukuShellLoader "$@"
